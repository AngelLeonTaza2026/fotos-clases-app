# ID de cliente OAuth de Google Cloud Console (tipo "Aplicación web").
# Este NO es secreto: viaja dentro del código que corre en el navegador.
VITE_GOOGLE_CLIENT_ID=tu_client_id_aqui.apps.googleusercontent.com

# Clave de la API de Gemini (Google AI Studio), para generar los resúmenes.
# Esta SÍ es secreta: se usa solo del lado del servidor, en /api/summarize.
# Por eso NO lleva el prefijo VITE_ — así Vite nunca la mete en el bundle.
GEMINI_API_KEY=tu_clave_de_gemini_aqui
